# VotoPaucarpata Engine — Environment Configuration
# Copy to .env and fill in real values.

# Database (PostgreSQL preferred, SQLite fallback)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/votopaucarpata
# DATABASE_URL=sqlite:///./votopaucarpata.db

# Vision AI — OpenAI GPT-4o-mini
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Vision AI — Google Gemini Flash (fallback)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# Local OCR (Tesseract + OpenCV) — offline fallback when no API key is set
LOCAL_OCR_ENABLED=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Cloud Storage (Supabase Storage compatible / S3 / Cloudinary)
# Use "local" for filesystem storage during development
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_KEY=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Processing
OCR_CONFIDENCE_THRESHOLD=0.90
WATCH_DIR=./whatsapp_actas_input
PROCESSED_DIR=./processed
REVIEW_DIR=./requires_review

# Credenciales de personeros (HMAC del QR; cambiar en producción)
CREDENCIAL_QR_SECRET=cambiar-en-produccion-min-32-caracteres

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000