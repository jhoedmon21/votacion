# Copia este archivo a .env y ajusta los valores.
# El .env real NO se sube a git.

# --- Base de datos ---
# PostgreSQL (producción / desarrollo local):
DATABASE_URL=postgresql+psycopg2://postgres:CLAVE@localhost:5432/computo_arequipa
# SQLite (fallback del prototipo):
# DATABASE_URL=sqlite:///./votopaucarpata.db

# --- OCR (opcional; la captura manual no lo requiere) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
TESSERACT_CMD=

# --- Storage de fotos de actas ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# --- Seguridad ---
# Secreto HMAC de las credenciales QR de personeros (cambiar en producción).
CREDENCIAL_QR_SECRET=dev-fuerza-arequipena-cambiar

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
