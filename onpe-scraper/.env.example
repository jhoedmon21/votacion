# ETL del padrón ONPE de Arequipa — copie a onpe-scraper/.env y complete.
# El CLI también acepta estas variables desde el entorno (export / CI secrets).

# --- Base de datos destino (SQLAlchemy) -------------------------------------
# PostgreSQL productivo (psycopg2):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/padron_arequipa
# MySQL alternativo (instale pymysql y úselo como driver):
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/padron_arequipa
# Desarrollo local sin servidor (SQLite, cero instalación):
# DATABASE_URL=sqlite:///./padron_arequipa.db

# Schema dedicado si el padrón convive con schema_arequipa.sql (ver DDL §0).
# "" = schema default. En PG el loader hace CREATE SCHEMA IF NOT EXISTS.
PADRON_SCHEMA=

# --- Fuente de datos ---------------------------------------------------------
# archivo | catalogo | check
PADRON_FUENTE=archivo
# Ruta al archivo oficial ONPE (CSV/JSON/XLSX). Acepta ruta relativa al cwd.
PADRON_ARCHIVO=onpe-scraper/fixtures/locales_mesas_ejemplo.csv
# Catálogo de datos abiertos (cuando el dataset esté publicado):
CATALOGO_BASE=https://www.datosabiertos.gob.pe
CATALOGO_TERMINO=locales de votacion ONPE
# URL directa al recurso (ZIP/CSV) si ya se identificó en el portal:
PADRON_RECURSO_URL=

# Filtro territorial ("" = las 8 provincias; ej. CAYLLOMA para una sola):
PADRON_SOLO_PROVINCIA=
# Tamaño de lote informativo del upsert (el commit es por provincia):
PADRON_LOTE_UPSERT=500
# Directorio de descargas temporales del catálogo:
PADRON_DIR_SALIDA=onpe-scraper/data/padron

# --- HTTP (anti-403 / anti-bloqueo) ------------------------------------------
HTTP_TIMEOUT_SEG=30
HTTP_PAUSA_SEG=1.5
HTTP_REINTENTOS=3
# HTTP_USER_AGENT=MiApp/1.0 (+contacto)  # por defecto: Chrome/Windows real

# --- Logs --------------------------------------------------------------------
LOG_NIVEL=INFO
